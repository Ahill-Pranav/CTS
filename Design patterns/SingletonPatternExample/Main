public class Main {

    public static void main(String[] args) {

        Logger logger1 = Logger.getInstance();
        Logger logger2 = Logger.getInstance();

        logger1.log("Application Started");
        logger2.log("Loading Configuration");

        // Verify both references point to the same object
        if (logger1 == logger2) {
            System.out.println("\nOnly one Logger instance exists.");
        } else {
            System.out.println("\nDifferent Logger instances exist.");
        }

        // Print object references
        System.out.println("\nLogger 1: " + logger1);
        System.out.println("Logger 2: " + logger2);
    }
}